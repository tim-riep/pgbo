{
  "name": "@pgbo/fastify",
  "version": "0.2.0",
  "description": "Fastify route factory for pgbo Business Objects — CRUD, metadata, value helps, pagination",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests"
  },
  "keywords": [
    "pgbo",
    "fastify",
    "crud",
    "route-factory",
    "business-objects"
  ],
  "author": "Tim Riep <tim@riep-tech.de>",
  "license": "MIT",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tim-riep/pgbo.git",
    "directory": "packages/pgbo-fastify"
  },
  "bugs": {
    "url": "https://github.com/tim-riep/pgbo/issues"
  },
  "homepage": "https://github.com/tim-riep/pgbo#readme",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@pgbo/core": "0.2.0"
  },
  "peerDependencies": {
    "fastify": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.2.1",
    "fastify": "^5.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.58.2",
    "vitest": "^4.1.4"
  }
}
