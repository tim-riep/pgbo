{
  "name": "pgbo-fastify",
  "version": "0.1.0",
  "description": "Fastify route factory for pgbo Business Objects — CRUD, metadata, value helps, pagination",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests"
  },
  "keywords": [
    "pgbo",
    "fastify",
    "crud",
    "route-factory",
    "business-objects"
  ],
  "author": "Tim Riep <tim@riep-tech.de>",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "pgbo": "0.1.0"
  },
  "peerDependencies": {
    "fastify": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "eslint": "^9.39.4",
    "fastify": "^5.3.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.58.2",
    "vitest": "^3.2.1"
  }
}
