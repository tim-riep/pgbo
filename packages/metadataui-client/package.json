{
  "name": "@metadataui/client",
  "version": "1.0.0",
  "description": "Framework-agnostic HTTP client for the metadata-driven UI contract — URL composition, typed fetch, metadata cache",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests"
  },
  "keywords": [
    "metadata",
    "ui",
    "client",
    "fetch",
    "http",
    "frontend",
    "crud"
  ],
  "author": "Tim Riep <tim@riep-tech.de>",
  "license": "MIT",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tim-riep/pgbo.git",
    "directory": "packages/metadataui-client"
  },
  "bugs": {
    "url": "https://github.com/tim-riep/pgbo/issues"
  },
  "homepage": "https://github.com/tim-riep/pgbo#readme",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@metadataui/spec": "1.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2",
    "vitest": "^4.1.5"
  }
}
