{
  "name": "@pgbo/core",
  "version": "0.1.0",
  "description": "Type-safe PostgreSQL Business Objects — tables, views, domains, auto-migration, native i18n",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "pgbo": "./dist/cli/index.js"
  },
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "default": "./dist/schema/index.js"
    },
    "./query": {
      "types": "./dist/query/index.d.ts",
      "default": "./dist/query/index.js"
    },
    "./validation": {
      "types": "./dist/validation/index.d.ts",
      "default": "./dist/validation/index.js"
    },
    "./seed": {
      "types": "./dist/seed/index.d.ts",
      "default": "./dist/seed/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./bo": {
      "types": "./dist/bo/index.d.ts",
      "default": "./dist/bo/index.js"
    },
    "./migration": {
      "types": "./dist/migration/index.d.ts",
      "default": "./dist/migration/index.js"
    },
    "./metadata": {
      "types": "./dist/metadata/index.d.ts",
      "default": "./dist/metadata/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "postgresql",
    "typescript",
    "orm",
    "business-objects",
    "views",
    "domains",
    "migration",
    "type-safe",
    "i18n"
  ],
  "author": "Tim Riep <tim@riep-tech.de>",
  "license": "MIT",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tim-riep/pgbo.git",
    "directory": "packages/pgbo"
  },
  "bugs": {
    "url": "https://github.com/tim-riep/pgbo/issues"
  },
  "homepage": "https://github.com/tim-riep/pgbo#readme",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/pg": "^8.15.4",
    "eslint": "^10.2.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.58.2",
    "vitest": "^4.1.4",
    "zod": "^4.0.0"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  }
}
